server_name: "${SERVER_NAME}"
public_baseurl: "${PUBLIC_BASEURL}/"
pid_file: /data/homeserver.pid
signing_key_path: /data/signing.key
log_config: /data/log.yaml
media_store_path: /media
report_stats: false
suppress_key_server_warning: true
trusted_key_servers: []
federation_domain_whitelist: []   # federation off in dev; open it per spec §1 later

listeners:
  - port: 8008
    type: http
    tls: false
    x_forwarded: true
    bind_addresses: ['0.0.0.0']
    resources:
      - names: [client]
  - port: 9093
    type: http
    tls: false
    bind_addresses: ['0.0.0.0']
    resources:
      - names: [replication]

database:
  name: psycopg2
  args:
    user: synapse
    password: "${POSTGRES_PASSWORD}"
    dbname: synapse
    host: postgres
    cp_min: 5
    cp_max: 10

redis:
  enabled: true
  host: redis
  port: 6379

worker_replication_secret: "${WORKER_REPLICATION_SECRET}"
instance_map:
  main:
    host: synapse
    port: 9093

# Media is served by media1 only; its worker file turns the media repo back on.
enable_media_repo: false
media_instance_running_background_jobs: media1
max_upload_size: 100M
url_preview_enabled: false

# Spec: no IP logs older than 7 days. chama-id also reads the user-level last_seen from these logs.
user_ips_max_age: 7d

enable_registration: false
# Linking a web client by QR code (spec §5): a signed-in device asks for a one-time login token
# (POST /_matrix/client/v1/login/get_token, at most 1 per minute per user). Chama accounts have no
# password, so Synapse has no user-interactive auth to offer here; the token only reaches the web
# encrypted to the key in its QR code, and the new device gets no message keys until it is verified.
login_via_existing_session:
  enabled: true
  require_ui_auth: false
  token_timeout: 2m
# chama-id's application service, for identity resets (spec §4).
app_service_config_files: [/data/appservices/chama-id.yaml]
registration_shared_secret: "${REGISTRATION_SHARED_SECRET}"
macaroon_secret_key: "${MACAROON_SECRET}"
form_secret: "${FORM_SECRET}"
password_config:
  enabled: false
jwt_config:
  enabled: true
  secret: "${JWT_SECRET}"
  algorithm: HS256
  subject_claim: sub
  issuer: chama-id
  audiences: [chama]

# Push (spec §6): the pusher1 worker sends every push to Sygnal. Pushes carry
# only event and room IDs; the phone fetches and decrypts the message itself.
pusher_instances: [pusher1]
push:
  include_content: false
# Dev: pushers must reach Sygnal on the Compose push network (10.0.2.0/24),
# which Synapse blocks by default as a private range.
ip_range_whitelist: ['10.0.2.0/24']

encryption_enabled_by_default_for_room_type: all
presence:
  enabled: true
user_directory:
  enabled: true
  search_all_users: false
allow_public_rooms_over_federation: false
require_auth_for_profile_requests: true
limit_profile_requests_to_users_who_share_rooms: false

rc_login:
  address: { per_second: 10, burst_count: 50 }
  account: { per_second: 10, burst_count: 50 }
rc_message:
  per_second: 50
  burst_count: 200
